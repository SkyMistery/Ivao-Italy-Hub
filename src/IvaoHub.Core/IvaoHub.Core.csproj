<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core: domain, EF Core, the IVAO API client and the Content folder.
    It never references IvaoHub.Web nor any IvaoHub.Modules.* project (design M0 section 6.2).
    The framework reference is needed because the design puts the OIDC back end for front end
    (Auth/) and the CRUD endpoint engine (MapCrud) inside the core, not in a separate host project.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The host sees the core's internals for one thing only: the end to end bench runs a job now
    (ScheduledJobs.RunNowAsync, note 2026-10-18-il-banco-fa-girare-un-job), which no installation and no module may call,
    because it skips "once per occurrence".
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="IvaoHub.Web" />
  </ItemGroup>

  <!--
    The shell of an interactive block's frame, compiled into the assembly rather than shipped as a
    file: there is then no way to deploy the application without it, and no way for an installation
    to hold a shell that does not match the code that fills it in (EmbedEndpoints).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Content\EmbedShell.html" />
    <EmbeddedResource Include="Content\EmbedGuidelines.md" />
    <EmbeddedResource Include="Content\EmbedPreview.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

  <!--
    Not used by the core's code: MailKit brings it in through MimeKit at 10.0.0, which has known
    advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). The direct reference lifts it, for the core
    and every project above it, to the patched version in Directory.Packages.props. It goes when a
    MimeKit release depends on a patched version itself (note 2026-10-15-il-pkcs-corretto).
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
