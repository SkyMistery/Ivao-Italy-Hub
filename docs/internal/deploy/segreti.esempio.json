  "$leggimi-Serilog": "Facoltativo, spento: l'hub scrive già il suo log in webapp/logs/. Per averne una copia anche nella logs/ alla radice dell'FTP, rinominate la chiave qui sotto da $esempio-Serilog a Serilog. Il percorso è relativo alla cartella di lavoro, webapp/. Non misurato sul server.",

  "$esempio-Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../logs/hub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  }
