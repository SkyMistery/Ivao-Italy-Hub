    "@tanstack/react-router": "1.170.32",
    "i18next": "26.4.1",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.1",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
