{
  "slug": "dashboard",
  "kind": "Dashboard",
  "title": {
    "$t": "seed.templates.dashboard.title"
  },
  "summary": {
    "$t": "seed.templates.dashboard.summary"
  },
  "body": {
    "schemaVersion": 1,
    "sections": [
      {
        "id": "s_welcome",
        "key": "welcome",
        "title": {
          "$t": "seed.templates.dashboard.welcome.section"
        },
        "layout": "stacked",
        "background": "none",
        "padding": "md",
        "width": "default",
        "required": true,
        "locked": true,
        "blocks": [
          {
            "id": "b_welcome_heading",
            "type": "heading",
            "version": 1,
            "props": {
              "level": 1,
              "text": {
                "$t": "seed.templates.dashboard.welcome.heading"
              }
            }
          },
          {
            "id": "b_welcome_text",
            "type": "text",
            "version": 1,
            "props": {
              "markdown": {
                "$t": "seed.templates.dashboard.welcome.text"
              }
            }
          }
        ]
      },
      {
        "id": "s_tools",
        "key": "tools",
        "title": {
          "$t": "seed.templates.dashboard.tools.section"
        },
        "layout": "1/2+1/2",
        "background": "none",
        "padding": "md",
        "width": "default",
        "required": false,
        "locked": false,
        "allowedBlocks": [
          "heading",
          "text",
          "callout",
          "cta",
          "linkList",
          "calendar",
          "newsList",
          "documentList",
          "stats",
          "networkStats",
          "staffList"
        ],
        "blocks": [
          {
            "id": "b_tools_calendar",
            "type": "calendar",
            "version": 1,
            "column": 0,
            "props": {
              "kinds": [],
              "range": "upcoming",
              "view": "agenda",
              "limit": 5
            }
          },
          {
            "id": "b_tools_news",
            "type": "newsList",
            "version": 1,
            "column": 1,
            "props": {
              "limit": 3,
              "layout": "list",
              "pinnedFirst": true
            }
          }
        ]
      },
      {
        "id": "s_notes",
        "key": "notes",
        "title": {
          "$t": "seed.templates.dashboard.notes.section"
        },
        "layout": "stacked",
        "background": "muted",
        "padding": "md",
        "width": "default",
        "required": false,
        "locked": false,
        "allowedBlocks": [
          "heading",
          "text",
          "callout",
          "cta",
          "table",
          "accordion"
        ],
        "blocks": []
      }
    ]
  }
}
