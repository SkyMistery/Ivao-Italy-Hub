              "what": "reviews",
              "limit": 5
            },
            "span": 3,
            "renderMode": "live"
          },
          {
            "id": "b_staff_drafts",
            "type": "myWork",
            "version": 1,
            "props": {
              "what": "drafts",
              "limit": 5
            },
            "span": 3,
