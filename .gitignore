# Private working notes of the maintainer — never part of the product. CLAUDE.md is not in this
# list since 24 September 2026: it holds the rules every contributor's Claude Code session must read.
# .claude/settings.json is committed for the same reason (the deny rules every session inherits);
# the rest of .claude/ (worktrees, local settings) stays private.
CLAUDE.local.md
.claude/*
!.claude/settings.json

# Secrets and per-environment configuration
/config/ivao-oauth.json
/secrets/
/hub-keys/
*.env
!*.example.json

# Build output
bin/
obj/
/artifacts/
/TestResults/
web/dist/
src/IvaoHub.Web/wwwroot/*
!src/IvaoHub.Web/wwwroot/.gitkeep
web/node_modules/

# Playwright: the browsers it downloads, the report it writes and the traces of a failed run.
web/playwright-report/
web/test-results/
web/blob-report/
web/.playwright/

# Scratch directory of the TanStack Router plugin.
web/.tanstack/
node_modules/

# Local data and logs
/data/
# Uploaded files: they belong to an installation, never to the repository.
/media/
# The base map: 179 MB of world, uploaded to an installation, never committed (tools/basemap.mjs).
/tiles/
/logs/
/diagnostics/
*.db
*.db-shm
*.db-wal

# IDE
.vs/
.idea/
*.user
.DS_Store

# A recorded flight flown again for the bench (web/e2e/full/replay.ts): written and removed by the round.
tests/fixtures/ivao/tracker-sessions-999001.json
tests/fixtures/ivao/tracker-*-9[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].json
